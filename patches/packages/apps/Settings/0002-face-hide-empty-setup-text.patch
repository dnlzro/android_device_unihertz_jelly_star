+    /**
+     * Hides headings, messages and icon rows with no text. AOSP leaves many of these strings for
+     * the manufacturer to fill in.
+     */
+    private void hideEmptyViews() {
+        final View row = (View) findViewById(R.id.info_message_glasses).getParent();
+        hideIfEmpty((View) row.getParent());
+    }
+
+    /** Returns whether the view has no text, hiding it if it's a text view or a group. */
+    private static boolean hideIfEmpty(View view) {
+        boolean empty = true;
+        if (view instanceof TextView) {
+            empty = ((TextView) view).getText().length() == 0;
+        } else if (view instanceof ViewGroup) {
+            final ViewGroup group = (ViewGroup) view;
+            for (int i = 0; i < group.getChildCount(); i++) {
+                empty &= hideIfEmpty(group.getChildAt(i));
+            }
+        } else {
+            return true;
+        }
+        if (empty) {
+            view.setVisibility(View.GONE);
+        }
+        return empty;
+    }
