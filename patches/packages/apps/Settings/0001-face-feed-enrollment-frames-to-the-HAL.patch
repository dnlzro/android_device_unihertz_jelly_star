+    /**
+     * Hands a frame to the face HAL, which empties the file each time it has consumed one.
+     */
+    private static void saveEnrollmentFrame(Image image) {
+        File frame = enrollmentFrameFile();
+        if (frame.length() > 0) {
+            return;
+        }
+        // Renamed into place so the HAL can never read a partly written frame.
+        File temp = new File(frame.getParent(), frame.getName() + ".tmp");
+        try (FileOutputStream out = new FileOutputStream(temp)) {
+            out.write(toNv21(image));
+        } catch (IOException e) {
+            Log.e(TAG, "Unable to save enrollment frame", e);
+            return;
+        }
+        if (!temp.renameTo(frame)) {
+            Log.e(TAG, "Unable to move enrollment frame into place");
+        }
+    }
+
+    private static File enrollmentFrameFile() {
+        return new File("/data/vendor_de/" + UserHandle.myUserId()
+                + "/facedata/faceIdEnroll.yuv");
+    }
+
+    /**
+     * Empties the file, so no picture of the user's face stays behind after enrollment.
+     */
+    private static void clearEnrollmentFrame() {
+        try {
+            new FileOutputStream(enrollmentFrameFile()).close();
+        } catch (IOException e) {
+            Log.e(TAG, "Unable to clear enrollment frame", e);
+        }
+    }
+
+    private static byte[] toNv21(Image image) {
+        Rect crop = image.getCropRect();
+        int width = crop.width();
+        int height = crop.height();
+        byte[] nv21 = new byte[width * height * 3 / 2];
+        Image.Plane[] planes = image.getPlanes();
+
+        ByteBuffer y = planes[0].getBuffer();
+        int yStride = planes[0].getRowStride();
+        int yPixel = planes[0].getPixelStride();
+        int position = 0;
+        for (int row = 0; row < height; row++) {
+            int start = (crop.top + row) * yStride + crop.left * yPixel;
+            for (int column = 0; column < width; column++) {
+                nv21[position++] = y.get(start + column * yPixel);
+            }
+        }
+
+        ByteBuffer u = planes[1].getBuffer();
+        ByteBuffer v = planes[2].getBuffer();
+        int uvStride = planes[1].getRowStride();
+        int uvPixel = planes[1].getPixelStride();
+        for (int row = 0; row < height / 2; row++) {
+            int start = (crop.top / 2 + row) * uvStride + (crop.left / 2) * uvPixel;
+            for (int column = 0; column < width / 2; column++) {
+                nv21[position++] = v.get(start + column * uvPixel);
+                nv21[position++] = u.get(start + column * uvPixel);
+            }
+        }
+        return nv21;
+    }
